DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,foremostroofing-production.up.railway.app
# Origins allowed for CSRF-protected POSTs (include the scheme).
CSRF_TRUSTED_ORIGINS=https://foremostroofing-production.up.railway.app

# Leave DATABASE_URL blank to use SQLite locally.
# Example Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/foremost_roofing
DATABASE_URL=

TIME_ZONE=Asia/Manila

# AI provider: claude or openai.
# The AI Analyst (chat + forecasts) uses OpenAI tool calling, so set this to
# openai and provide an OPENAI_API_KEY. After changing roles/permissions run
# `python manage.py seed_erp` so the `ai.chat` permission is applied.
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_CLAUDE=claude-sonnet-4-6
# gpt-4o handles multi-step tool calling more reliably; gpt-4o-mini is cheaper.
AI_MODEL_OPENAI=gpt-4o
